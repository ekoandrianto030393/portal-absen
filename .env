# --- KONFIGURASI DATABASE ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=biometrik_absensi_wajah_db

# --- JAM OPERASIONAL ABSENSI ---
# Jam mulai boleh absen masuk
JAM_MASUK_START=07:15:00
# Jam terakhir boleh absen masuk (lewat ini ditolak)
JAM_MASUK_END=9:12:00
# Jam mulai boleh absen pulang
JAM_PULANG_START=13:35:00
# Jam paling awal boleh pulang PSW (Sebelum jam ini ditolak/cegah scan ganda)
BATAS_MIN_PULANG=13:30:00
# Jam Pulang Khusus Jumat & Sabtu
JAM_PULANG_JUMAT=14:45:00
JAM_PULANG_SABTU=14:45:00

# --- ATURAN KETERLAMBATAN ---
# Jam resmi masuk kerja (digunakan untuk menghitung berapa menit telat)
JAM_KERJA_MULAI=08:00:00
# Batas toleransi telat (lewat jam ini status jadi TELAT)
# Contoh: 12:15:00)
BATAS_TELAT=08:17:00

# --- ATURAN POTONGAN & AUTO-FIX (JIKA LUPA ABSEN PULANG) ---
# Jumlah jam yang dipotong jika lupa absen pulang 
POTONGAN_LUPA_PULANG=1
# (Digunakan untuk menghitung total jam kerja harian jika lupa tap pulang)
# Contoh: Dianggap pulang jam 14:00:00
AUTO_PULANG_DEFAULT=14:00:00
AUTO_PULANG_DEFAULT_JUMAT=14:00:00
AUTO_PULANG_DEFAULT_SABTU=14:00:00
